# syntax=docker/dockerfile:1.7

# Add the Emmy compiler plugin to an exact prebuilt 1Cat image without changing
# 1Cat's model loader, scheduler, TP/PP collectives, or stateful sparse-attention/cache paths.
# Build from the repository root after `make wheel`:
#
#   docker build -f docker/1cat-vllm-sm70/Dockerfile.emmy \
#     --build-arg BASE_IMAGE=cloudriftai/1cat-vllm-deepseek-v4-flash-0731:1.2.3-d76126608 \
#     -t emmy/1cat-vllm-deepseek-v4-flash-0731:local .

ARG BASE_IMAGE
ARG EMMY_ASSETS=empty-emmy-assets

# The ordinary bounded-leaf image has no prebuilt external-program assets. A full
# DeepSeek image supplies a BuildKit named context instead:
#
#   --build-context external-emmy-assets=/path/to/assets \
#   --build-arg EMMY_ASSETS=external-emmy-assets
#
# The context has pack/, cubin/, and triton/ at its root. Keeping it outside the
# repository avoids committing generated execution plans and binary caches.
FROM ${BASE_IMAGE} AS empty-emmy-assets
RUN mkdir -p /pack /cubin /triton

FROM ${EMMY_ASSETS} AS selected-emmy-assets

FROM ${BASE_IMAGE}

COPY dist/emmy_ml-*.whl /tmp/emmy-wheel/
COPY docker/1cat-vllm-sm70/shims/kv_rope_fp8_insert.py /tmp/onecat-shims/kv_rope_fp8_insert.py
RUN pip install --no-cache-dir --no-deps /tmp/emmy-wheel/emmy_ml-*.whl \
    && pip install --no-cache-dir cupy-cuda12x==14.1.1 \
    && test "$(sha256sum /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu_worker.py \
        | cut -d ' ' -f 1)" = "d0b6b8570e20373bde6b8d7cd787666c38d4a0a0145350797525689f6894f6e4" \
    && test "$(sha256sum /usr/local/lib/python3.12/dist-packages/vllm/v1/core/sched/output.py \
        | cut -d ' ' -f 1)" = "3f8f295f226c5e152b5dd368de5a7cba3be4af488fed7c2500fc9bbcf321f239" \
    && test "$(sha256sum /usr/local/lib/python3.12/dist-packages/vllm/v1/request.py \
        | cut -d ' ' -f 1)" = "462c17cfde4308f0eb35eb0b2afa6b4ba3e628caa481dee9f476297bec373f1e" \
    && test "$(sha256sum /usr/local/lib/python3.12/dist-packages/vllm/triton_utils/jit_monitor.py \
        | cut -d ' ' -f 1)" = "6463bebae253f3e0229e62aef9c4c8695934edd35042a331e19eefe882e62b53" \
    && emmy_onecat_sm70_dir="$(python3 -c \
        'import pathlib, vllm.models.deepseek_v4.sm70 as sm70; print(pathlib.Path(sm70.__file__).parent)' \
        | tail -n 1)" \
    && test "$(sha256sum "$emmy_onecat_sm70_dir/qnorm_rope_kv_fp8_insert.py" \
        | cut -d ' ' -f 1)" = "4c4031ff88c227cda4fa7e2a6b4e5c95585ba5ade2194aa26584b3aa0b49c853" \
    && cp /tmp/onecat-shims/kv_rope_fp8_insert.py \
        "$emmy_onecat_sm70_dir/kv_rope_fp8_insert.py" \
    && rm -rf /tmp/emmy-wheel /tmp/onecat-shims

COPY --from=selected-emmy-assets /pack /opt/emmy/pack
COPY --from=selected-emmy-assets /cubin /opt/emmy/cubin
COPY --from=selected-emmy-assets /triton /opt/emmy/triton

ARG ONECAT_DEEPSEEK_V4=0
ARG COMPILER_INTEGRATION=onecat-leaf
ARG COMPILER_KERNEL=sm70-rms-norm-fp16
ENV EMMY_CUBIN_CACHE=/opt/emmy/cubin \
    EMMY_PACK_DIR=/opt/emmy/pack \
    TRITON_CACHE_DIR=/opt/emmy/triton \
    EMMY_ONECAT_DEEPSEEK_V4=${ONECAT_DEEPSEEK_V4}

LABEL ai.emmy.compiler.integration="${COMPILER_INTEGRATION}" \
      ai.emmy.compiler.kernel="${COMPILER_KERNEL}" \
      ai.emmy.onecat.q-cache-shim="d76126608" \
      ai.emmy.onecat.native-prefill-warmup="d76126608"
