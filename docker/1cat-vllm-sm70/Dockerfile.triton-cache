# syntax=docker/dockerfile:1.7

# Add target-card Triton and TileLang caches to an already pinned 1Cat serving image.
# Build with a context containing triton-cache/, tilelang-cache/, and tilelang-jit-cache/:
#
#   docker build -f Dockerfile.triton-cache \
#     --build-arg BASE_IMAGE=cloudriftai/onecat-vllm-deepseek-v4-flash-0731:sm70-d76126608 \
#     --build-arg TRITON_CACHE_MANIFEST_SHA256=<sha256> \
#     --build-arg TILELANG_CACHE_MANIFEST_SHA256=<sha256> \
#     --build-arg TILELANG_JIT_CACHE_MANIFEST_SHA256=<sha256> \
#     -t cloudriftai/onecat-vllm-deepseek-v4-flash-0731:sm70-d76126608-jitfree .

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG TRITON_CACHE_MANIFEST_SHA256
ARG TILELANG_CACHE_MANIFEST_SHA256
ARG TILELANG_JIT_CACHE_MANIFEST_SHA256
COPY --chown=root:root triton-cache/ /root/.triton/cache/
COPY --chown=root:root tilelang-cache/ /root/.tilelang/cache/
COPY --chown=root:root tilelang-jit-cache/ /root/.cache/tilelang/

ENV TRITON_CACHE_DIR=/root/.triton/cache \
    TILELANG_CACHE_DIR=/root/.tilelang/cache

LABEL ai.vllm.triton-cache.manifest-sha256="${TRITON_CACHE_MANIFEST_SHA256}" \
      ai.vllm.tilelang-cache.manifest-sha256="${TILELANG_CACHE_MANIFEST_SHA256}" \
      ai.vllm.tilelang-jit-cache.manifest-sha256="${TILELANG_JIT_CACHE_MANIFEST_SHA256}" \
      ai.vllm.jit-cache.target="NVIDIA Tesla V100 SXM3 32GB"
