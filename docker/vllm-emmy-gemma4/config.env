# The pinned gemma-4 release serving config — the SINGLE source for the warm run, the
# baked image ENV/CMD, and the verify run. Every value here is part of the cubin
# cache key (it changes which programs exist / their shapes), so the warm and the
# released image must read the same file. Make-includable syntax: VAR=value only.
#
# Pinned by the 2026-07-17 RTX 5090 headroom sweep (post memory fixes): 4096/4096 with
# the decode twin ON — 16x the pre-fix ctx-256 floor; 4096 is the dynamic-dim cap.
# Util 0.90, NOT 0.97: the runner uploads ~2 GiB of device residents (embed table +
# norm) lazily after vLLM's profiling, so 0.97 leaves them no room and the engine dies
# at the first small-batch decode (0.97: 73/256 bench requests then a fatal; 0.90:
# 256/256, 130.9 tok/s, no fatal). Raise once the eager-allocation fix lands.
GEMMA4_MODEL=google/gemma-4-12B
GEMMA4_MAX_MODEL_LEN=4096
GEMMA4_MAX_NUM_BATCHED_TOKENS=4096
GEMMA4_GPU_MEM_UTIL=0.90
# 16 = decode twin on (affordable since the weight/activation sharing landed); 0 disables.
GEMMA4_DECODE_BUCKET=16
