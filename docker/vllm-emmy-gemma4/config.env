# The pinned gemma-4 release serving config — the SINGLE source for the warm run, the
# baked image ENV/CMD, and the verify run. Every value here is part of the cubin
# cache key (it changes which programs exist / their shapes), so the warm and the
# released image must read the same file. Make-includable syntax: VAR=value only.
#
# Pinned to the blog-article benchmark protocol (2026-07-23, RTX 5090): the
# instruction-tuned checkpoint, --max-model-len 8448 (the 4096-in/4096-out headline
# workload + margin), decode bucket 32 (the tuned default of the decode-goldens
# sessions; the 64-stream point's EMMY_GEN_DECODE_BUCKET=64 knob is a run-time
# override that falls back to the full cubin-cached compile). Util 0.97: the plugin's
# device residents (embed table + norm) are claimed BEFORE vLLM profiling, so they
# must sit inside the utilization budget — at 0.90 the KV cache no longer fits.
GEMMA4_MODEL=google/gemma-4-12B-it
GEMMA4_MAX_MODEL_LEN=8448
GEMMA4_MAX_NUM_BATCHED_TOKENS=4096
GEMMA4_GPU_MEM_UTIL=0.97
# 32 = decode twin on at the tuned bucket; 0 disables.
GEMMA4_DECODE_BUCKET=32
