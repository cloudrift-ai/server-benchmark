# The pinned gemma-4 release serving config — the SINGLE source for the warm run, the
# baked image ENV/CMD, and the verify run. Every value here is part of the cubin
# cache key (it changes which programs exist / their shapes), so the warm and the
# released image must read the same file. Make-includable syntax: VAR=value only.
#
# Pinned by the 2026-07-17 RTX 5090 sessions: 4096/4096 with the decode twin ON — 16x
# the pre-memory-fix ctx-256 floor; 4096 is the dynamic-dim cap. Util 0.97: with the
# eager device-resident allocation the ~2 GiB of residents (embed table + norm) are
# claimed BEFORE vLLM profiling, so they sit inside the utilization budget — at 0.90
# the KV cache no longer fits (0.41 GiB free vs 1.32 needed for one max-len request),
# while 0.97 boots and validates 4/4 vs HF. (Pre-fix it was the exact opposite: 0.90
# passed and 0.97 died at the first small-batch decode.)
GEMMA4_MODEL=google/gemma-4-12B
GEMMA4_MAX_MODEL_LEN=4096
GEMMA4_MAX_NUM_BATCHED_TOKENS=4096
GEMMA4_GPU_MEM_UTIL=0.97
# 16 = decode twin on (affordable since the weight/activation sharing landed); 0 disables.
GEMMA4_DECODE_BUCKET=16
