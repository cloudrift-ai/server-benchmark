# The base Gemma 4 12B checkpoint has the same text architecture as the instruction-tuned
# checkpoint, but its weights and completion contract are distinct. This config pins the
# exact base checkpoint for the warm, baked image, and offline verification.
SERVE_MODEL=google/gemma-4-12B
SERVE_REVISION=023679ed352de9bb66cc873c9009ce3482585c08
SERVE_GOLDEN_FILE=emmy/compiler/pipeline/search/goldens/rtx5090_sm120_gemma4_base.yaml
SERVE_MAX_MODEL_LEN=25088
SERVE_MAX_NUM_BATCHED_TOKENS=4128
SERVE_GPU_MEM_UTIL=0.97
SERVE_DECODE_BUCKET=32
SERVE_GPU="NVIDIA GeForce RTX 5090"
# Qualify both precision regimes at the final serving shape. The recipe selects FAST_MATH
# only if the exact base-checkpoint accuracy gate remains green.
SERVE_WARM_SHAPES=":::fm"
