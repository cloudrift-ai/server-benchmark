# Pinned FP16 Llama 3.1 8B release envelope for one 32 GB V100. The NousResearch
# checkpoint is byte-identical to the gated Meta weight payload at this revision.
SERVE_MODEL=NousResearch/Meta-Llama-3.1-8B-Instruct
SERVE_REVISION=d10aef7999a2b5ba950ab3974312feeedbfe0b77
SERVE_GOLDEN_FILE=emmy/compiler/pipeline/search/goldens/v100_sm70_meta_llama_3_1_8b_instruct.yaml
SERVE_GPU="NVIDIA Tesla V100 SXM3 32GB"

# 65,536 tokens is the qualified single-card FP16 context. The compiler realization
# envelope covers M=1 decode, the 32-token decode bucket, 512-token prefill chunks,
# and the symbolic fallback without tying placement rules to these product shapes.
SERVE_MAX_MODEL_LEN=65536
SERVE_MAX_NUM_BATCHED_TOKENS=544
SERVE_GPU_MEM_UTIL=0.88
SERVE_DECODE_BUCKET=32
SERVE_PREFILL_CAPACITY=512
SERVE_PREFILL_BUCKET=512
SERVE_M1_TIER=1
SERVE_EXTRA_ARGS="--max-num-seqs 8"
