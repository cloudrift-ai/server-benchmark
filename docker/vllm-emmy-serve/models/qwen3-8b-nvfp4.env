# nvidia/Qwen3-8B-NVFP4 on one RTX 5090 — the W4A4 lane: the checkpoint declares 4-bit weights AND
# 4-bit activations for every transformer Linear, and emmy's loader owns both halves, so the engine
# is handed a shape-only unquantized twin (`loader.quant.engine_config_overrides`).
SERVE_MODEL=nvidia/Qwen3-8B-NVFP4
SERVE_REVISION=ccd10a893cbca613259517c3efe08e151ddf2b8e
SERVE_GOLDEN_FILE=recipes/Qwen3-8B-NVFP4/golden/rtx5090_sm120.yaml
SERVE_MAX_MODEL_LEN=4096
SERVE_MAX_NUM_BATCHED_TOKENS=4112
SERVE_GPU_MEM_UTIL=0.97
SERVE_DECODE_BUCKET=16
SERVE_GPU="NVIDIA GeForce RTX 5090"
# No SERVE_WARM_SHAPES: this release qualifies the standard precision lane only. A FAST_MATH lane
# doubles the realization matrix and is only kept when it also passes the accuracy gate, which is a
# separate qualification from making the W4A4 path serve.
